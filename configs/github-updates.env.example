# Harbor GitHub updater stub
#
# The GitHub repo is Ivantech123/Harbor. It is referenced from:
# 1. surfer.json  → brands.*.release.github.repo + updateHostname
# 2. prefs/harbor/updates.yaml → harbor.updates.github.* + app.update.*
# 3. branding prefs / branding.nsi (release + twilight)
# 4. npm run ffprefs
# 5. When update.xml + .mar hosting is ready: set updateHostname,
#    flip app.update.enabled / app.update.auto to true
#
# Auto-update is OFF in this stub so builds never hit a foreign update server.
# Manual “download update” / release-notes links point at GitHub Releases.

REPO=Ivantech123/Harbor
RELEASES_URL=https://github.com/Ivantech123/Harbor/releases
LATEST_URL=https://github.com/Ivantech123/Harbor/releases/latest

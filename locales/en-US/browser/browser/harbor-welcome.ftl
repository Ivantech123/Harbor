harbor-welcome-title-line1 = Welcome aboard
harbor-welcome-title-line2 = Harbor

harbor-welcome-start = Begin
harbor-welcome-back = Back
harbor-welcome-skip = Skip for now

harbor-welcome-import-title = Bring your stuff along.
harbor-welcome-import-description = Import your bookmarks, history and passwords from another browser and pick up right where you left off.
harbor-welcome-import-yes = <strong>YES</strong>, import from another browser.
harbor-welcome-import-no = <strong>NO</strong>, start fresh.

harbor-welcome-default-browser-title = Make { -brand-short-name } your default?
harbor-welcome-default-browser-description = Links from other apps will open in { -brand-short-name }. You can always change this later.
harbor-welcome-set-default-browser = <strong>YES</strong>, make { -brand-short-name } default.
harbor-welcome-dont-set-default-browser = <strong>NO</strong>, still exploring my options.

harbor-welcome-default-search-title = Pick your search engine.
harbor-welcome-default-search-description = Choose your default search engine. You can always change it later!

harbor-welcome-essentials-title = Choose the apps you use most.
harbor-welcome-essentials-description = Select your favorite apps to keep them handy in your sidebar.

harbor-welcome-block-ads-title = Block ads and trackers?
harbor-welcome-block-ads-description = { -brand-short-name } can install uBlock Origin for you, so pages load cleaner and faster. You can remove it any time.
harbor-welcome-block-ads-yes = <strong>YES</strong>, block ads for me.
harbor-welcome-block-ads-no = <strong>NO</strong>, show me everything.

harbor-welcome-workspace-colors-title = Your space, your colors.
harbor-welcome-workspace-colors-description = Personalize your browser by giving each space its own unique color identity.

harbor-welcome-start-browsing-title = All set? Let’s get rolling!
harbor-welcome-start-browsing-description-1 = You’re all set up and ready to go. Click the button below to start browsing with { -brand-short-name }.
harbor-welcome-start-browsing = Dive in!

harbor-share-space =
    .label = Share Space…
harbor-share-folder =
    .label = Share Folder…
harbor-share-split-view =
    .label = Share Split View…

harbor-share-link-copied-toast = Share link copied!
harbor-share-link-expires-description = Anyone with the link can open it until { $date }
harbor-share-link-permanent-description = Anyone with the link can open it

harbor-share-error-toast = Couldn't create a share link
harbor-share-error-auth-description = The share server rejected your key
harbor-share-error-too-large-description = This share is too big to upload

harbor-share-overlay-shared-with-you = Shared with you
harbor-share-overlay-add-space = Add Space to Harbor
harbor-share-overlay-add-folder = Add Folder to Harbor
harbor-share-imported-toast = Added to your browser!
harbor-share-import-error-toast = Couldn't import this share
harbor-share-import-error-dead-description = The link has expired or doesn't exist
harbor-share-import-error-invalid-description = The shared data is invalid


+@interface HarborWindowMaterialView : NSVisualEffectView
+- (void)prefChanged;
+@end
+
+static void HarborWindowMaterialPrefChanged(const char* aPref, void* aClosure) {
+  [static_cast<HarborWindowMaterialView*>(aClosure) prefChanged];
+}
+
+static constexpr nsLiteralCString kHarborWindowMaterialPrefs[] = {
+    "harbor.widget.macos.window-material"_ns,
+    "harbor.view.grey-out-inactive-windows"_ns,
+};
+
+static NSVisualEffectMaterial HarborWindowMaterial() {
+  switch (StaticPrefs::harbor_widget_macos_window_material()) {
+    case 1:
+      return NSVisualEffectMaterialHUDWindow;
+    case 2:
+      return NSVisualEffectMaterialFullScreenUI;
+    case 3:
+      return NSVisualEffectMaterialPopover;
+    case 4:
+      return NSVisualEffectMaterialMenu;
+    case 5:
+      return NSVisualEffectMaterialToolTip;
+    case 6:
+      return NSVisualEffectMaterialHeaderView;
+    case 7:
+    default:
+      return NSVisualEffectMaterialUnderWindowBackground;
+  }
+}
+
+@implementation HarborWindowMaterialView
+- (instancetype)initWithFrame:(NSRect)aRect {
+  self = [super initWithFrame:aRect];
+  self.appearance = nil;
+  self.emphasized = NO;
+  self.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+  [self prefChanged];
+  for (const auto& pref : kHarborWindowMaterialPrefs) {
+    Preferences::RegisterCallback(HarborWindowMaterialPrefChanged, pref, self);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  for (const auto& pref : kHarborWindowMaterialPrefs) {
+    Preferences::UnregisterCallback(HarborWindowMaterialPrefChanged, pref, self);
+  }
+  [super dealloc];
+}
+
+- (void)prefChanged {
+  self.state = StaticPrefs::harbor_view_grey_out_inactive_windows()
+                   ? NSVisualEffectStateFollowsWindowActiveState
+                   : NSVisualEffectStateActive;
+  self.material = HarborWindowMaterial();
+}
+@end
+
+static void HarborWindowVibrancyPrefChanged(const char* aPref, void* aClosure) {
+  static_cast<nsCocoaWindow*>(aClosure)->UpdateWindowMaterial();
+}
+
+void nsCocoaWindow::SetWindowClass(const nsAString& aXulWinType,
+                                   const nsAString& aXulWinClass,
+                                   const nsAString& aXulWinName) {
+  if (mWindowType != WindowType::TopLevel || mIsBrowserWindow ||
+      !aXulWinType.EqualsLiteral("navigator:browser")) {
+    return;
+  }
+  mIsBrowserWindow = true;
+  Preferences::RegisterCallback(HarborWindowVibrancyPrefChanged,
+                                "harbor.widget.macos.window-vibrancy", this);
+  UpdateWindowMaterial();
+}
+
+void nsCocoaWindow::UpdateWindowMaterial() {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
+
+  if (!mWindow) {
+    return;
+  }
+  bool wanted = StaticPrefs::harbor_widget_macos_window_vibrancy();
+  if (wanted ==
+      [mWindow.contentView isKindOfClass:[HarborWindowMaterialView class]]) {
+    return;
+  }
+
+  NSRect frame = mWindow.contentView.frame;
+  NSView* wrapper = wanted ? [[HarborWindowMaterialView alloc] initWithFrame:frame]
+                           : [[NSView alloc] initWithFrame:frame];
+  wrapper.wantsLayer = YES;
+  for (NSView* view in [mWindow contentViewContents]) {
+    [view removeFromSuperviewWithoutNeedingDisplay];
+    [wrapper addSubview:view];
+  }
+  mWindow.contentView = wrapper;
+  [wrapper release];
+
+  NS_OBJC_END_TRY_IGNORE_BLOCK;
+}
